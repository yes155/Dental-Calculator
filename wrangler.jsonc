{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-calculator",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
